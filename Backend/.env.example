# Clerk — must be the SAME instance as the frontend, or token verification fails
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk → Webhooks → add endpoint POST /api/v1/webhooks/clerk, then copy the signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:3000
