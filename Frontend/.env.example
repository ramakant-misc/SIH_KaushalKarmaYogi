# Clerk — get these from https://dashboard.clerk.com (Developers → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk sends users. The single login page serves all three roles.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Backend base URL. Used only when NEXT_PUBLIC_USE_MOCKS=false.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# true  = serve every endpoint from src/mocks (default while the backend is being built)
# false = call the real backend at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_USE_MOCKS=true
